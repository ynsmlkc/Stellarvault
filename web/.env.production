# Public testnet config — safe to commit (contract addresses + RPC only, no secrets).
# Vercel auto-loads this on production builds, so no manual env entry is needed.
#
# This is the ONLY env file git tracks: .env and .env.local are ignored, so a
# key added there reaches localhost and nothing else. Anything the deployed app
# needs belongs here.

NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Vault factory — deploys one contract per vault, and keeps the owner→vaults
# registry the dashboard lists from.
NEXT_PUBLIC_FACTORY_ID=CA3VDWIXCP4THSE7HTYAGTYGY257USCN2WYC2JOI7C3IUVZKPV4JXTAW
# The vault-instance build the factory serves — what "upgrade this vault" targets.
NEXT_PUBLIC_VAULT_WASM_HASH=d4557e7af97a55ef796c18bd1afa5ab6eebabfdb1d2fd955bdc86d96f5735794

NEXT_PUBLIC_TOKEN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Groth16 verifier keyed to voteApproval.circom — anonymous approvals.
NEXT_PUBLIC_GROTH16_VERIFIER_ID=CDAG3Y7JS52WCIOWO37FDXVTS5WQBSCRNPO42NRSKV53LYQQTPWH3GLB

# Confidential token stack (ours) — hidden amounts, wrapping the native XLM SAC.
NEXT_PUBLIC_CONFIDENTIAL_TOKEN_ID=CDTZAT6D3XYS43A5Z6KVXZIFCBIVLBNO4R75OF2WWLCMCWZDQNBI3W2K
NEXT_PUBLIC_CONFIDENTIAL_VERIFIER_ID=CCB4WJQHSKSY2KF6BYZ6IUISTERRBGLHM5WU4E6CLWW2E4QOSMDVKRNZ
NEXT_PUBLIC_CONFIDENTIAL_AUDITOR_ID=CDJAFGSWQSYV32IMG5B7LYOULDJDCZM3AOSNSFV76YKDSEYZ34L5VGOW
NEXT_PUBLIC_CONFIDENTIAL_FROM_LEDGER=3984917

# Which auditor id new confidential accounts register under.
#   0 = a real keypair (held by whoever deployed the stack) — amounts decryptable
#   1 = a nothing-up-my-sleeve point, derived by hashing
#       "stellar-vault/no-auditor/v1" onto Grumpkin rather than as k·G, so no
#       discrete log exists for anyone. The channel stays structurally present
#       and is openable by nobody. See spike/confidential-token/.
NEXT_PUBLIC_CONFIDENTIAL_AUDITOR_INDEX=1
